+    x = np.asarray(v, dtype=float) / vsini
+    out = np.zeros_like(x)
+    inside = np.abs(x) < 1.0
+    one_x2 = 1.0 - x[inside] ** 2
+    out[inside] = (2.0 * (1.0 - eps) * np.sqrt(one_x2) + 0.5 * np.pi * eps * one_x2) / (np.pi * vsini * (1.0 - eps / 3.0))
+    return out
