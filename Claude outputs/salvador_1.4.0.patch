+    ([26.0, 26.0, 22.0, 22.0], [0, -4, -4, -3], [0, -4, 0, -3]),
+    ([28.0], [-4], [0]),                                  # single saturated line (e.g. K I 7699)
+    ([20.0, 20.0], [-1, -4], [-1, 0]),                    # the other line rejected by EWR: not usable
+    ([20.0, 20.0], [-2, -1], [-2, -1]),                   # no saturated line: nothing changes
