+    assert 'FLAG = -4  (REJ. COG SLOPE)' in (path / f'{STAR}.fit').read_text()
+    assert [r[:6] + r[7:] for r in rows(path / f'{STAR}.fit')] == [r[:6] + r[7:] for r in rows(EXPECTED_SUBSET / f'{STAR}.fit')]
